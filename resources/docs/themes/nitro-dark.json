{
    "name": "nitro-dark",
    "type": "dark",
    "colors": {
        "editor.background": "#0f172a",
        "editor.foreground": "#cbd5e1"
    },
    "tokenColors": [
        { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#64748b", "fontStyle": "italic" } },
        { "scope": ["keyword", "storage", "storage.type", "storage.modifier", "keyword.control", "keyword.other", "variable.language.this", "constant.language"], "settings": { "foreground": "#60a5fa" } },
        { "scope": ["entity.name.function", "support.function", "meta.function-call", "meta.method-call", "entity.name.function.member"], "settings": { "foreground": "#38bdf8" } },
        { "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type", "entity.other.inherited-class", "entity.name.namespace", "support.other.namespace"], "settings": { "foreground": "#93c5fd" } },
        { "scope": ["string", "string.quoted", "punctuation.definition.string"], "settings": { "foreground": "#fbbf24" } },
        { "scope": ["constant.numeric", "constant.other"], "settings": { "foreground": "#f59e0b" } },
        { "scope": ["meta.attribute", "meta.attribute.php", "support.attribute", "keyword.other.attribute"], "settings": { "foreground": "#fcd34d" } },
        { "scope": ["variable", "variable.other", "variable.parameter"], "settings": { "foreground": "#e2e8f0" } },
        { "scope": ["variable.other.property", "variable.other.object.property", "meta.property"], "settings": { "foreground": "#cbd5e1" } },
        { "scope": ["entity.name.tag", "punctuation.definition.tag"], "settings": { "foreground": "#60a5fa" } },
        { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#7dd3fc" } },
        { "scope": ["keyword.operator", "punctuation", "meta.brace"], "settings": { "foreground": "#94a3b8" } }
    ]
}
