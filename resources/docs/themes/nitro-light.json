{
    "name": "nitro-light",
    "type": "light",
    "colors": {
        "editor.background": "#f8fafc",
        "editor.foreground": "#334155"
    },
    "tokenColors": [
        { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#94a3b8", "fontStyle": "italic" } },
        { "scope": ["keyword", "storage", "storage.type", "storage.modifier", "keyword.control", "keyword.other", "variable.language.this", "constant.language"], "settings": { "foreground": "#2563eb" } },
        { "scope": ["entity.name.function", "support.function", "meta.function-call", "meta.method-call", "entity.name.function.member"], "settings": { "foreground": "#0369a1" } },
        { "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type", "entity.other.inherited-class", "entity.name.namespace", "support.other.namespace"], "settings": { "foreground": "#1e40af" } },
        { "scope": ["string", "string.quoted", "punctuation.definition.string"], "settings": { "foreground": "#b45309" } },
        { "scope": ["constant.numeric", "constant.other"], "settings": { "foreground": "#d97706" } },
        { "scope": ["meta.attribute", "meta.attribute.php", "support.attribute", "keyword.other.attribute"], "settings": { "foreground": "#d97706" } },
        { "scope": ["variable", "variable.other", "variable.parameter"], "settings": { "foreground": "#0f172a" } },
        { "scope": ["variable.other.property", "variable.other.object.property", "meta.property"], "settings": { "foreground": "#334155" } },
        { "scope": ["entity.name.tag", "punctuation.definition.tag"], "settings": { "foreground": "#2563eb" } },
        { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#0369a1" } },
        { "scope": ["keyword.operator", "punctuation", "meta.brace"], "settings": { "foreground": "#64748b" } }
    ]
}
